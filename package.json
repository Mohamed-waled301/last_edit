{
  "name": "apex-apparel-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Apex Apparel ERP - نظام تخطيط موارد المؤسسات المتكامل",
  "author": "Apex Apparel ERP",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && electron . --dev\"",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --win --x64",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node tools/migrate-from-hostinger/migrate.js",
    "db:verify": "node tools/migrate-from-hostinger/verify.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.2.5",
    "@fontsource/tajawal": "^5.2.5",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dexie": "^4.4.6",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "lucide-react": "^1.51.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.apexapparelerp.app",
    "productName": "Apex Apparel ERP",
    "copyright": "Copyright © 2026 Apex Apparel ERP",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!tools/**/*",
      "!**/*.pem",
      "!**/*.rar",
      "!**/*.db*",
      "!**/*.sqlite*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام Apex Apparel ERP",
      "artifactName": "Apex-Apparel-ERP-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Apex-Apparel-ERP-Portable-${version}.exe"
    }
  }
}
