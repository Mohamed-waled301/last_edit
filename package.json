{
  "name": "code-systems",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "description": "code systems - نظام تخطيط موارد المؤسسات المتكامل",
  "author": "code systems",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:cutting": "cross-env EDITION=cutting vite",
    "dev:standard": "cross-env EDITION=standard vite",
    "start": "vite",
    "build": "vite build",
    "build:cutting": "cross-env EDITION=cutting vite build",
    "build:standard": "cross-env EDITION=standard vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && electron . --dev\"",
    "electron:start": "electron .",
    "electron:cutting": "cross-env EDITION=cutting electron .",
    "electron:standard": "cross-env EDITION=standard electron .",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:build:cutting": "cross-env EDITION=cutting npm run build:cutting && electron-builder --win --x64 -c.appId=com.codesystems.cutting.app -c.productName=\"code systems Cutting\" -c.nsis.shortcutName=\"نظام code systems (إصدار القص)\" -c.nsis.artifactName=\"code-systems-cutting-Setup-${version}.exe\" -c.portable.artifactName=\"code-systems-cutting-Portable-${version}.exe\"",
    "electron:build:standard": "cross-env EDITION=standard npm run build:standard && electron-builder --win --x64 -c.appId=com.codesystems.standard.app -c.productName=\"code systems Standard\" -c.nsis.shortcutName=\"نظام code systems (الإصدار القياسي)\" -c.nsis.artifactName=\"code-systems-standard-Setup-${version}.exe\" -c.portable.artifactName=\"code-systems-standard-Portable-${version}.exe\"",
    "test": "vitest run",
    "test:cutting": "cross-env EDITION=cutting vitest run",
    "test:standard": "cross-env EDITION=standard vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node tools/migrate-from-hostinger/migrate.js",
    "db:verify": "node tools/migrate-from-hostinger/verify.js",
    "license:reset-dev": "node tools/reset-dev-license.cjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.2.5",
    "@fontsource/tajawal": "^5.2.5",
    "better-sqlite3": "11.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dexie": "^4.4.6",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "lucide-react": "^1.51.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.apexapparelerp.app",
    "productName": "code systems",
    "copyright": "Copyright © 2026 code systems",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!tools/**/*",
      "!**/*.pem",
      "!**/*.rar",
      "!**/*.db*",
      "!**/*.sqlite*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام code systems",
      "artifactName": "code-systems-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "code-systems-Portable-${version}.exe"
    }
  }
}
