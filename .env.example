# ========================================================================
# Hostinger MySQL Database Credentials (for Vercel & Local API)
# ========================================================================

# عنوان خادم قاعدة البيانات في Hostinger (يظهر في Hostinger hPanel -> Databases)
# مثال: srv1234.hstgr.io أو رقم الـ IP الخاص بالخادم
MYSQL_HOST=srv000.hstgr.io

# منفذ الاتصال الافتراضي بـ MySQL
MYSQL_PORT=3306

# اسم مستخدم قاعدة البيانات في Hostinger
MYSQL_USER=u123456789_erp_user

# كلمة مرور مستخدم قاعدة البيانات في Hostinger
MYSQL_PASSWORD=YourStrongDatabasePasswordHere

# اسم قاعدة البيانات التي أنشأتها في Hostinger
MYSQL_DATABASE=u123456789_erp_db

# تشغيل بروتوكول SSL المشفر (اختياري: true أو false)
MYSQL_SSL=false
